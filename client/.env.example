# ============================================================
# The Recruiting Standard - Public Website Environment
# ============================================================
# Copy to `client/.env.local` for local development.
# Staging/production values are configured in the Vercel project.

# Public canonical site URL (used by sitemap.ts, robots.ts, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the REST API consumed by the public site / portal 
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Backup contact email shown on the public contact page and form
NEXT_PUBLIC_CONTACT_EMAIL=mvp418.recruiting@gmail.com
