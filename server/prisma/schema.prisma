generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum GlobalRole {
  PLATFORM_ADMIN
  SCHOOL_STAFF
  ATHLETE
  PARENT
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum SchoolRole {
  SCHOOL_ADMIN
  COACH_RECRUITER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  ENROLLMENT_LETTER
  REPORT_CARD
  TRANSCRIPT
  ELIGIBILITY
  COMBINE_REPORT
  PHYSICAL
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RecruitingStatus {
  EVALUATING
  CONTACTED
  OFFERED
  COMMITTED
  PASSED
}

enum SubscriptionPlan {
  ANNUAL_1500
  MONTHLY_250
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  WAIVED
}

enum SubscriptionState {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
  PENDING
}

enum BillingProvider {
  MANUAL
  AUTOMATED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionBillingEventType {
  CREATED
  PAYMENT_RECORDED
  RENEWED
  ACTIVATED
  SUSPENDED
  CANCELLED
  EXPIRED
  STATE_CHANGED
  PLAN_CHANGED
  PAYMENT_STATUS_CHANGED
  TERM_UPDATED
  INVOICE_CREATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFUNDED
  WEBHOOK_RECEIVED
}

enum GuardianLinkStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum LegalDocumentKey {
  TERMS_OF_USE
  PRIVACY_POLICY
}

enum GuardianAuthorizationStatus {
  PENDING
  AUTHORIZED
  EXPIRED
  REVOKED
}

enum HighlightProvider {
  CLOUDINARY
  HUDL
  YOUTUBE
  VIMEO
  OTHER
}

// ----------------------------------------------------
// Core Entities
// ----------------------------------------------------

model School {
  id                String       @id @default(uuid())
  schoolId          String?      @unique // Permanent unique ID assigned on approval (e.g. SCH-10492)
  name              String
  address           String?
  city              String?
  country           String       @default("United States")
  provinceRegion    String?
  postalCode        String?
  contactEmail      String
  contactPhone      String?
  status            SchoolStatus @default(PENDING)
  approvedAt        DateTime?
  approvedById      String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  memberships       SchoolMembership[]
  subscription      Subscription?
  recruitingRecords RecruitingRecord[]
  savedProspects    SavedProspect[]

  @@index([status])
  @@index([schoolId])
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  dateOfBirth       DateTime?
  schoolId          String?
  globalRole        GlobalRole
  status            UserStatus   @default(ACTIVE)
  tokenVersion      Int          @default(0)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  memberships       SchoolMembership[]
  athleteProfile    AthleteProfile?
  savedProspects    SavedProspect[]
  reviewedDocuments Document[]   @relation("DocumentReviewer")
  passwordResetTokens PasswordResetToken[]
  guardianLinks     ParentAthleteLink[] @relation("GuardianLinks")
  athleteLinks      ParentAthleteLink[] @relation("AthleteLinks")
  guardianAuthorization GuardianAuthorization?
  legalAcceptances  LegalAcceptance[]
  highlightVideos   HighlightVideo[]

  @@index([email])
  @@index([globalRole])
  @@index([schoolId])
}

// Links a Parent/Guardian account to an Athlete account. The athlete must
// approve the request before the parent can act within their linked workflow.
model ParentAthleteLink {
  id            String             @id @default(uuid())
  parentUserId  String
  athleteUserId String
  status        GuardianLinkStatus @default(PENDING)
  respondedAt   DateTime?
  consentGrantedAt DateTime?
  consentRevokedAt DateTime?
  consentVersion   String?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  parent        User               @relation("GuardianLinks", fields: [parentUserId], references: [id], onDelete: Cascade)
  athlete       User               @relation("AthleteLinks", fields: [athleteUserId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, athleteUserId])
  @@index([parentUserId, status])
  @@index([athleteUserId, status])
}

model GuardianAuthorization {
  id                    String                       @id @default(uuid())
  userId                String                       @unique
  guardianName          String
  guardianEmail         String
  status                GuardianAuthorizationStatus  @default(PENDING)
  tokenHash             String                       @unique
  version               String
  expiresAt             DateTime
  requestedAt           DateTime                     @default(now())
  respondedAt           DateTime?
  authorizedAt          DateTime?
  authorizationVersion  String?

  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([expiresAt])
}

model LegalAcceptance {
  id           String           @id @default(uuid())
  userId       String
  documentKey  LegalDocumentKey
  version      String
  acceptedAt   DateTime         @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentKey, version])
  @@index([userId, acceptedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SchoolMembership {
  id          String           @id @default(uuid())
  userId      String
  schoolId    String
  role        SchoolRole
  title       String?          // e.g. "Head Coach - Boys Basketball", "Athletic Director"
  status      MembershipStatus @default(ACTIVE)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId, role])
}

model AthleteProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  sports               String[]           // Array of varsity sports
  graduationYear       Int
  primarySport         String
  positions            String[]           // Array of positions/events
  heightInches         Int?
  weightLbs            Int?
  gpa                  Float?
  actScore             Int?
  satScore             Int?
  highSchoolName       String?
  city                 String?
  state                String?
  highlightLinks       String[]           // Video links (Hudl, YouTube, Vimeo)
  athleticStats        Json?              // Sport-specific stats & combine metrics
  completionPercentage Int                @default(0) // 0-100%
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  verificationNotes    String? // Reviewer decision notes (required on rejection)
  submittedForVerificationAt DateTime? // When the athlete last submitted for review
  verifiedAt           DateTime?
  verifiedById         String?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents            Document[]
  savedProspects       SavedProspect[]
  recruitingRecords    RecruitingRecord[]

  @@index([verificationStatus])
  @@index([primarySport, graduationYear])
}

// Highlight videos are intentionally separate from AthleteProfile so an athlete
// can publish film before the full profile builder is completed. These are
// public-to-school assets (unlike Document records, which stay private).
model HighlightVideo {
  id              String            @id @default(uuid())
  userId          String
  title           String?
  videoUrl        String
  provider        HighlightProvider @default(OTHER)
  publicId        String?           // Cloudinary public_id, used for deletion
  durationSeconds Int?
  sizeBytes       Int?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, videoUrl])
  @@index([userId, createdAt])
}

model Document {
  id                 String         @id @default(uuid())
  athleteProfileId   String
  type               DocumentType
  title              String
  privateStorageRef  String         @unique // Private S3/GCS object key, NEVER public URLs
  fileSizeBytes      Int
  mimeType           String
  status             DocumentStatus @default(PENDING)
  reviewerId         String?
  reviewerNotes      String?
  reviewedAt         DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  athleteProfile     AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  reviewer           User?          @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([athleteProfileId, status])
  @@index([status])
}

model SavedProspect {
  id               String         @id @default(uuid())
  schoolId         String
  coachUserId      String
  athleteProfileId String
  notes            String?
  savedAt          DateTime       @default(now())

  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  coach            User           @relation(fields: [coachUserId], references: [id], onDelete: Cascade)
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  @@unique([schoolId, coachUserId, athleteProfileId])
  @@index([schoolId])
}

model RecruitingRecord {
  id               String           @id @default(uuid())
  schoolId         String
  athleteProfileId String
  contactLogs      Json             @default("[]") // Array of { id, date, type, notes, coachName }
  offers           Json             @default("[]") // Array of { id, date, type, details, status }
  commitments      Json?            // { committedDate, details }
  status           RecruitingStatus @default(EVALUATING)
  privateNotes     String?          // School-private evaluation notes, NEVER leaked cross-school
  lastContactAt    DateTime?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  athleteProfile   AthleteProfile   @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  @@unique([schoolId, athleteProfileId])
  @@index([schoolId, status])
}

model SubscriptionPriceOption {
  id               String             @id @default(uuid())
  code             String             @unique
  legacyPlan       SubscriptionPlan   @unique
  name             String
  amountCents      Int
  currency         String             @default("USD")
  billingInterval  BillingInterval
  intervalCount    Int                @default(1)
  lateFeeCents     Int                @default(0)
  lateFeeTaxRate   Float              @default(0)
  isActive         Boolean            @default(true)
  effectiveFrom    DateTime           @default(now())
  effectiveTo      DateTime?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  subscriptions    Subscription[]

  @@index([isActive, billingInterval])
}

model Subscription {
  id                        String                        @id @default(uuid())
  schoolId                  String                        @unique
  schoolCode                String?
  plan                      SubscriptionPlan
  paymentStatus             PaymentStatus                 @default(PENDING)
  state                     SubscriptionState             @default(PENDING)
  startDate                 DateTime?
  expirationDate            DateTime?
  lastPaymentAt             DateTime?
  lastPaymentAmountCents    Int?
  notes                     String?                       // Manual billing log entries from Platform Admin

  priceOptionId             String?
  priceOptionCode           String?
  billingProvider           BillingProvider               @default(MANUAL)
  providerCustomerRef       String?
  providerSubscriptionRef   String?
  providerPriceRef          String?
  billingStatus             String?
  currency                  String                        @default("USD")
  amountCents               Int                           @default(0)
  billingInterval           BillingInterval?
  intervalCount             Int                           @default(1)
  currentPeriodStart        DateTime?
  currentPeriodEnd          DateTime?
  nextBillingDate           DateTime?
  cancelAtPeriodEnd         Boolean                       @default(false)
  canceledAt                DateTime?
  autoCollectEnabled        Boolean                       @default(false)
  billingMetadata           Json?

  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt

  school                    School                        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  priceOption               SubscriptionPriceOption?      @relation(fields: [priceOptionId], references: [id], onDelete: SetNull)
  billingEvents             SubscriptionBillingEvent[]

  @@index([schoolId, state])
  @@index([schoolCode])
  @@index([billingProvider])
  @@index([nextBillingDate])
  @@index([priceOptionId])
}

model SubscriptionBillingEvent {
  id                String                        @id @default(uuid())
  subscriptionId    String
  schoolId          String
  type              SubscriptionBillingEventType
  provider          BillingProvider               @default(MANUAL)
  providerEventRef  String?
  idempotencyKey    String?                       @unique
  amountCents       Int?
  currency          String                        @default("USD")
  periodStart       DateTime?
  periodEnd         DateTime?
  statusFrom        String?
  statusTo          String?
  description       String
  metadata          Json?
  occurredAt        DateTime                      @default(now())
  createdAt         DateTime                      @default(now())

  subscription      Subscription                  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, occurredAt])
  @@index([schoolId, occurredAt])
  @@index([type])
}
