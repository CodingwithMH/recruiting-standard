generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum GlobalRole {
  PLATFORM_ADMIN
  SCHOOL_STAFF
  ATHLETE
  PARENT
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum SchoolRole {
  SCHOOL_ADMIN
  COACH_RECRUITER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  TRANSCRIPT
  ELIGIBILITY
  COMBINE_REPORT
  PHYSICAL
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RecruitingStatus {
  EVALUATING
  CONTACTED
  OFFERED
  COMMITTED
  PASSED
}

enum SubscriptionPlan {
  ANNUAL_1500
  MONTHLY_250
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  WAIVED
}

enum SubscriptionState {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
  PENDING
}

enum GuardianLinkStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum HighlightProvider {
  CLOUDINARY
  HUDL
  YOUTUBE
  VIMEO
  OTHER
}

// ----------------------------------------------------
// Core Entities
// ----------------------------------------------------

model School {
  id                String       @id @default(uuid())
  schoolId          String?      @unique // Permanent unique ID assigned on approval (e.g. SCH-10492)
  name              String
  address           String?
  city              String?
  country           String       @default("United States")
  provinceRegion    String?
  postalCode        String?
  contactEmail      String
  contactPhone      String?
  status            SchoolStatus @default(PENDING)
  approvedAt        DateTime?
  approvedById      String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  memberships       SchoolMembership[]
  subscription      Subscription?
  recruitingRecords RecruitingRecord[]
  savedProspects    SavedProspect[]

  @@index([status])
  @@index([schoolId])
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  dateOfBirth       DateTime?
  schoolId          String?
  globalRole        GlobalRole
  status            UserStatus   @default(ACTIVE)
  tokenVersion      Int          @default(0)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  memberships       SchoolMembership[]
  athleteProfile    AthleteProfile?
  savedProspects    SavedProspect[]
  reviewedDocuments Document[]   @relation("DocumentReviewer")
  passwordResetTokens PasswordResetToken[]
  guardianLinks     ParentAthleteLink[] @relation("GuardianLinks")
  athleteLinks      ParentAthleteLink[] @relation("AthleteLinks")
  highlightVideos   HighlightVideo[]

  @@index([email])
  @@index([globalRole])
  @@index([schoolId])
}

// Links a Parent/Guardian account to an Athlete account. The athlete must
// approve the request before the parent can act within their linked workflow.
model ParentAthleteLink {
  id            String             @id @default(uuid())
  parentUserId  String
  athleteUserId String
  status        GuardianLinkStatus @default(PENDING)
  respondedAt   DateTime?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  parent        User               @relation("GuardianLinks", fields: [parentUserId], references: [id], onDelete: Cascade)
  athlete       User               @relation("AthleteLinks", fields: [athleteUserId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, athleteUserId])
  @@index([parentUserId, status])
  @@index([athleteUserId, status])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SchoolMembership {
  id          String           @id @default(uuid())
  userId      String
  schoolId    String
  role        SchoolRole
  title       String?          // e.g. "Head Coach - Boys Basketball", "Athletic Director"
  status      MembershipStatus @default(ACTIVE)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId, role])
}

model AthleteProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  sports               String[]           // Array of varsity sports
  graduationYear       Int
  primarySport         String
  positions            String[]           // Array of positions/events
  heightInches         Int?
  weightLbs            Int?
  gpa                  Float?
  actScore             Int?
  satScore             Int?
  highSchoolName       String?
  city                 String?
  state                String?
  highlightLinks       String[]           // Video links (Hudl, YouTube, Vimeo)
  athleticStats        Json?              // Sport-specific stats & combine metrics
  completionPercentage Int                @default(0) // 0-100%
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  verifiedAt           DateTime?
  verifiedById         String?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents            Document[]
  savedProspects       SavedProspect[]
  recruitingRecords    RecruitingRecord[]

  @@index([verificationStatus])
  @@index([primarySport, graduationYear])
}

// Highlight videos are intentionally separate from AthleteProfile so an athlete
// can publish film before the full profile builder is completed. These are
// public-to-school assets (unlike Document records, which stay private).
model HighlightVideo {
  id              String            @id @default(uuid())
  userId          String
  title           String?
  videoUrl        String
  provider        HighlightProvider @default(OTHER)
  publicId        String?           // Cloudinary public_id, used for deletion
  durationSeconds Int?
  sizeBytes       Int?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, videoUrl])
  @@index([userId, createdAt])
}

model Document {
  id                 String         @id @default(uuid())
  athleteProfileId   String
  type               DocumentType
  title              String
  privateStorageRef  String         // Private S3/GCS object key, NEVER public URLs
  fileSizeBytes      Int
  mimeType           String
  status             DocumentStatus @default(PENDING)
  reviewerId         String?
  reviewerNotes      String?
  reviewedAt         DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  athleteProfile     AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  reviewer           User?          @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([athleteProfileId, status])
  @@index([status])
}

model SavedProspect {
  id               String         @id @default(uuid())
  schoolId         String
  coachUserId      String
  athleteProfileId String
  notes            String?
  savedAt          DateTime       @default(now())

  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  coach            User           @relation(fields: [coachUserId], references: [id], onDelete: Cascade)
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  @@unique([schoolId, coachUserId, athleteProfileId])
  @@index([schoolId])
}

model RecruitingRecord {
  id               String           @id @default(uuid())
  schoolId         String
  athleteProfileId String
  contactLogs      Json             @default("[]") // Array of { id, date, type, notes, coachName }
  offers           Json             @default("[]") // Array of { id, date, type, details, status }
  commitments      Json?            // { committedDate, details }
  status           RecruitingStatus @default(EVALUATING)
  privateNotes     String?          // School-private evaluation notes, NEVER leaked cross-school
  lastContactAt    DateTime?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  athleteProfile   AthleteProfile   @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  @@unique([schoolId, athleteProfileId])
  @@index([schoolId, status])
}

model Subscription {
  id                     String            @id @default(uuid())
  schoolId               String            @unique
  plan                   SubscriptionPlan
  paymentStatus          PaymentStatus     @default(PENDING)
  state                  SubscriptionState @default(PENDING)
  startDate              DateTime?
  expirationDate         DateTime?
  lastPaymentAt          DateTime?
  lastPaymentAmountCents Int?
  notes                  String?           // Manual billing log entries from Platform Admin

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, state])
}
