# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recruiting_standard?schema=public"

# Authentication & Session Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Redis Cache / Rate Limiter (Optional in local dev)
REDIS_URL=redis://localhost:6379

# Email Delivery (Nodemailer - for invitations & verification notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@therecruitingstandard.com

# Stripe Manual / Automated Configuration (Placeholder for future billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
