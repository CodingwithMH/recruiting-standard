# ============================================================
# The Recruiting Standard - API Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in values for your environment.
# Never commit real secrets. Environment-specific values are injected
# by the hosting provider (Render/Railway) in staging and production.

# Application Environment
# Allowed: development | test | staging | production
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma)
# dev:     local Docker/Postgres or a dedicated Neon branch
# staging: Neon staging branch / staging database
# prod:    Neon production database (never shared with staging)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recruiting_standard?schema=public"

# Direct (non-pooled) connection used by Prisma Migrate.
# For Neon, copy DATABASE_URL and remove the "-pooler" suffix from the host.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/recruiting_standard?schema=public"

# Authentication & Session Security
# Generate with: openssl rand -base64 48 (minimum 32 characters)
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Redis Cache / Rate Limiter (Optional in local development)
REDIS_URL=redis://localhost:6379

# Private Document Storage (S3-compatible, Block All Public Access)
# Leave blank in local development; required in staging/production.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=900
# Maximum private document upload size (10 MB)
DOCUMENT_MAX_SIZE_BYTES=10485760

# Public Highlight Video Storage (Cloudinary Free plan)
# Create a free account: https://cloudinary.com/users/register_free
# Dashboard -> Programmable Media -> Dashboard -> Product Environment Credentials.
# Leave blank in local development to disable video uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=recruiting-standard/highlights
# 100 MB (Cloudinary free-plan per-video limit)
CLOUDINARY_MAX_VIDEO_BYTES=104857600

# Transactional Email (invitations & verification notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@therecruitingstandard.com
# Inbox that receives public contact-form inquiries.
CONTACT_INBOX_EMAIL=mvp418.recruiting@gmail.com
